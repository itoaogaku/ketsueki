# Notion Internal Integration Secret
# https://www.notion.so/profile/integrations で作成して取得します
NOTION_TOKEN=

# 血液検査データのデータベースID（npm run setup:notion で作成、または既存DBのURLから取得）
NOTION_BLOOD_DATABASE_ID=

# 試合結果のデータベースID（既存のNotionデータベースのURLから取得）
NOTION_GAMES_DATABASE_ID=

# 部員データベースのID（既存のNotionデータベースのURLから取得、任意）
# 選手の生年月日から学年を自動計算するために使用します。設定しない場合は、
# 血液検査データベースの「学年」列（手入力）がそのまま使われます。
NOTION_MEMBERS_DATABASE_ID=

# WAスコアデータベースのID（npm run setup:notion -- --with-wa-scores で作成、
# または既存DBのURLから取得、任意）
# 競技結果（5000m/10000m/ハーフマラソン/マラソンなど）をWorld Athletics
# スコアリングテーブルの得点に変換した一覧です。npm run sync:wa-scores で
# 競技結果データベースから変換・反映します。設定しない場合、「個人の推移」の
# 競技成績グラフはサンプルデータで表示されます。
NOTION_WA_SCORES_DATABASE_ID=

# npm run setup:notion で新規にデータベースを作成する場合のみ使用
# （作成先の親ページのID。ページのURL中の32文字のIDの部分）
NOTION_PARENT_PAGE_ID=

# /import ページ（ブラウザからのCSVアップロード）を保護するパスコード。
# 設定しない場合、デプロイ先URLを知っている人は誰でもインポートできてしまうため、
# 本番環境（Vercel）では必ず設定することを推奨します。
IMPORT_SECRET=

# 女子選手用の血液検査データのデータベースID（男子用のNOTION_BLOOD_DATABASE_ID
# とは別のNotionデータベース。任意 - 未設定の場合、/joshi はサンプルデータで
# 表示されます）。競技結果・WAスコアの各データベースは男女共通のものを性別列
# （性別/種目/結果）で振り分けて使うため、これらのIDは血液検査データベースのみ
# 男女で分ける形になります。
NOTION_WOMEN_BLOOD_DATABASE_ID=

# 女子選手用ダッシュボード（/joshi）を保護する合言葉。設定しない場合、/joshi
# は誰が合言葉を入力しても認証されません（＝実質アクセス不可）。本番環境
# （Vercel）で /joshi を使う場合は必ず設定してください。IMPORT_SECRET とは
# 別の値を推奨します。
WOMEN_DASHBOARD_SECRET=
