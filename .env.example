# Notion Internal Integration Secret
# https://www.notion.so/profile/integrations で作成して取得します
NOTION_TOKEN=

# 血液検査データのデータベースID（npm run setup:notion で作成、または既存DBのURLから取得）
NOTION_BLOOD_DATABASE_ID=

# 試合結果のデータベースID（既存のNotionデータベースのURLから取得）
NOTION_GAMES_DATABASE_ID=

# npm run setup:notion で新規にデータベースを作成する場合のみ使用
# （作成先の親ページのID。ページのURL中の32文字のIDの部分）
NOTION_PARENT_PAGE_ID=
